# Shared
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Internal service URLs (gateway → downstream)
USERS_SERVICE_URL=http://localhost:3001
GROUPS_SERVICE_URL=http://localhost:3002
EXPENSES_SERVICE_URL=http://localhost:3003
BALANCES_SERVICE_URL=http://localhost:3004

# Gateway
GATEWAY_PORT=3000

# MCP server (apps/mcp-server) — logs in on startup via gateway /auth/login
EXPENSE_SPLITTER_URL=http://localhost:3000/api/v1
EXPENSE_SPLITTER_EMAIL=alice@example.com
EXPENSE_SPLITTER_PASSWORD=password123

# Users
USERS_HTTP_PORT=3001
USERS_DATABASE_URL=postgres://postgres:postgres@localhost:5436/users_db

# Groups
GROUPS_HTTP_PORT=3002
GROUPS_DATABASE_URL=postgres://postgres:postgres@localhost:5433/groups_db

# Expenses
EXPENSES_HTTP_PORT=3003
EXPENSES_DATABASE_URL=postgres://postgres:postgres@localhost:5434/expenses_db

# Balances
BALANCES_HTTP_PORT=3004
BALANCES_DATABASE_URL=postgres://postgres:postgres@localhost:5435/balances_db
